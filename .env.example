# Groq chat assistant (server-side only; never prefix these with VITE_)
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Web3Forms access key for the server-side enquiry function
WEB3FORMS_ACCESS_KEY=replace_with_your_web3forms_access_key

# Consultation booking uses the Cal.com booking page in the frontend.
# Google OAuth credentials are not required for enquiries or bookings.
