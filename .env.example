# Groq chat assistant (server-side only; never prefix these with VITE_)
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Google OAuth credentials for both Gmail enquiry notifications and Google Calendar booking
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=replace_with_offline_refresh_token
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIME_ZONE=Europe/London
